# Frontend (this repo) runs at http://localhost:3000
# Production site: https://futurepathtech.dev
HOST=localhost

# Backend API origin. Leave empty to use the CRA proxy (/api -> http://localhost:4000).
REACT_APP_API_URL=http://localhost:4000

# Public site URL used after Paddle checkout
REACT_APP_SITE_URL=http://localhost:3000

# Paddle Billing (client-side)
# sandbox | production
REACT_APP_PADDLE_ENV=sandbox
REACT_APP_PADDLE_CLIENT_TOKEN=
REACT_APP_PADDLE_PRICE_ID=
